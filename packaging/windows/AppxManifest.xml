<?xml version="1.0" encoding="utf-8"?>
<!-- Sparse package: gives the installed ExpenseKrafter.exe a package identity
     (no files of its own; it points at the install folder) so it can appear in
     the Windows Share sheet for statement files. Built, signed and registered
     by share_target.py. Identity must match ExpenseKrafter.exe.manifest. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity Name="Kraftinglabs.ExpenseKrafter" Publisher="CN=ExpenseKrafter Local Signing"
            Version="1.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ExpenseKrafter</DisplayName>
    <PublisherDisplayName>Kraftinglabs</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="ExpenseKrafter" Executable="ExpenseKrafter.exe"
                 uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <!-- AppListEntry none: the Start menu keeps your own shortcut, not a second one. -->
      <uap:VisualElements DisplayName="ExpenseKrafter" Description="Import statements into ExpenseKrafter"
                          BackgroundColor="transparent" AppListEntry="none"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Import a statement into ExpenseKrafter">
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
              <uap:FileType>.xlsx</uap:FileType>
              <uap:FileType>.xls</uap:FileType>
              <uap:FileType>.csv</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
